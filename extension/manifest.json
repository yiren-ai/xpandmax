{
  "manifest_version": 3,
  "name": "XpandMax",
  "version": "0.9.6",
  "description": "See follower counts and Chinese bios on X. Local translation by default; optional no-key Google or custom API.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "translation-background.js" },
  "options_page": "translation-options.html",
  "action": {
    "default_title": "XpandMax 设置",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "settings.js",
        "follow.js",
        "translation.js",
        "content.js",
        "velocity.js",
        "share.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://xpandmax.com"
}
